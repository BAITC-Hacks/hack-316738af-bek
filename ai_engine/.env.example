# Copy to a local .env file, never to frontend configuration.
OPENAI_API_KEY=
# Select an available Responses model supporting strict JSON Schema.
OPENAI_MODEL=gpt-4.1
NVIDIA_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
ANALYSIS_TIMEOUT_SECONDS=600
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_REQUESTS=100
AI_MAX_OUTPUT_TOKENS=12000
AI_CONCURRENCY=3
AI_MAX_RISK_PAIRS=200
