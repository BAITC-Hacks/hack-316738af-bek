# Allow only runtime/build inputs into the Docker context.
*
!Dockerfile
!backend/
backend/*
!backend/__init__.py
!backend/app/
!backend/app/**
!backend/requirements.txt
!contracts/
!contracts/**
!ai_engine/
!ai_engine/**
!frontend/
!frontend/**
**/.env
**/.env.*
**/__pycache__
**/*.pyc
**/.venv
**/node_modules
**/dist
**/.git
**/data
**/*.sqlite*
**/test-results
**/local_reports
**/private_inputs
**/playwright-report
**/.tools
**/tests
**/integration
**/docs/screenshots
**/*.pem
**/*.key
