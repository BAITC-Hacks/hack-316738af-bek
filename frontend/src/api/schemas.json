              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message",
          "document_id",
          "span_ids"
        ]
      },
      "SourceLocator": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "docx",
              "pdf",
              "xlsx"
            ]
          },
          "clause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": "string"
          },
          "page": {
            "anyOf": [
