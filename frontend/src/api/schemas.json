              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "cell_range": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "clause",
          "path",
          "page",
          "sheet",
          "cell_range"
        ]
